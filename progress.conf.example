# 写作进度追踪表 —— 配置
# 复制本文件为 progress.conf 后按本机情况修改；修改后需重启服务生效。

[paths]
# 笔记工作区根目录。留空则使用本脚本所在目录。
root =
# TeXStudio 可执行文件路径。留空则自动探测（先读注册表 .tex 关联，再查常见安装位置）。
texstudio =

[server]
# 监听地址。127.0.0.1 表示仅本机可访问。
host = 127.0.0.1
# 端口。被占用时自动顺延（最多尝试 10 个）。
port = 8765
# 启动后是否自动打开浏览器。
auto_open = true

[scan]
# 额外忽略的目录名，逗号分隔（以 . 或 _ 开头的目录已自动忽略）。
ignore =
# 判定「有内容」的阈值：剔除标题、注释、空行与 input 行后，剩余字符数需大于此值。
min_chars = 50
# 停滞提醒：某本笔记超过这么多天没有改动则标出。
stagnant_days = 14
# 续写区显示的最近改动文件数。
recent_count = 6
