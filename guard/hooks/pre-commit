#!/bin/sh
# 提交前把关：拦截本机信息（用户名 / 本机路径 / 专有词）
#
# 由工具仓库的 check_sensitive.py 提供。脚本按下列顺序查找，因此本钩子
# 不含任何本机绝对路径，可直接随仓库分发：
#   1) 本仓库根目录 / guard/     （工具仓库自身）
#   2) 同级目录下的 Tools/guard/ （笔记仓库、模板仓库的情形）
#   3) 上一级目录下的 Tools/guard/
# 词表来自沿途的 .sensitive-words.txt（脚本会逐级向上收集合并）。
#
# 装法：cp guard/hooks/pre-commit <仓库>/.git/hooks/pre-commit && chmod +x <仓库>/.git/hooks/pre-commit
# 卸载：删除该文件即可
# 临时跳过单次检查：git commit --no-verify

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

SCRIPT=""
for CAND in "$REPO/check_sensitive.py" \
            "$REPO/guard/check_sensitive.py" \
            "$REPO/../Tools/guard/check_sensitive.py" \
            "$REPO/../../Tools/guard/check_sensitive.py"; do
    if [ -f "$CAND" ]; then
        SCRIPT="$CAND"
        break
    fi
done

# 找不到脚本就放行 —— 绝不让检查本身阻断提交
[ -z "$SCRIPT" ] && exit 0

if command -v python >/dev/null 2>&1; then
    python "$SCRIPT" || exit 1
elif command -v py >/dev/null 2>&1; then
    py -3 "$SCRIPT" || exit 1
fi
exit 0
